#!/usr/bin/env python3
"""
Particle Filter Localization Node  (ROS 1 / Duckiebot)
=======================================================
Subscriptions
  ~odom          nav_msgs/Odometry
  ~ar_detection  std_msgs/Float64MultiArray  [distance_m, bearing_rad]

Publications
  ~particles     geometry_msgs/PoseArray
                   pose.position.z  = weight * N_PARTICLES  (encoded weight)
  ~pf_estimate   geometry_msgs/Pose
                   position.z = yaw [rad]

Algorithm: SIR particle filter  (Probabilistic Robotics, Ch. 4)
Motion model  : odometry-based (Thrun et al., Alg. 5.4)
Sensor model  : multi-hypothesis  p(z|x) = sum_i p(z|x, tag_i)
Resampling    : low-variance, triggered when N_eff < N/2
"""

import math
import threading

import numpy as np
import rospy
from geometry_msgs.msg import Pose, PoseArray
from nav_msgs.msg import Odometry
from std_msgs.msg import Float64MultiArray

from pf_localization.constants import (
    TAG_POSITIONS, ROOM_X_MIN, ROOM_X_MAX, ROOM_Y_MIN, ROOM_Y_MAX
)

# ── Tunable parameters (also settable via rosparam) ─────────────────────────
N_PARTICLES = 2000
ALPHA       = [0.10, 0.05, 0.05, 0.02]   # odometry noise (a1..a4)
SIGMA_DIST  = 0.10   # [m]   distance std  (larger than sim to absorb real-sensor noise)
SIGMA_BEAR  = 0.08   # [rad] bearing std
MIN_WEIGHT  = 1e-200
# ────────────────────────────────────────────────────────────────────────────


def _quat_to_yaw(q):
    return math.atan2(2.0 * (q.w * q.z + q.x * q.y),
                      1.0 - 2.0 * (q.y ** 2 + q.z ** 2))


def _angle_diff(a, b):
    d = a - b
    return (d + math.pi) % (2 * math.pi) - math.pi


class ParticleFilterNode:

    def __init__(self):
        rospy.init_node('particle_filter', anonymous=False)

        global N_PARTICLES, SIGMA_DIST, SIGMA_BEAR, ALPHA
        N_PARTICLES = rospy.get_param('~n_particles', N_PARTICLES)
        SIGMA_DIST  = rospy.get_param('~sigma_dist',  SIGMA_DIST)
        SIGMA_BEAR  = rospy.get_param('~sigma_bear',  SIGMA_BEAR)
        ALPHA       = rospy.get_param('~alpha',        ALPHA)

        self.lock       = threading.Lock()
        self.particles  = self._uniform_init()
        self.weights    = np.ones(N_PARTICLES) / N_PARTICLES
        self.prev_odom  = None
        self.pf_traj    = []
        self.odom_traj  = []

        self.particles_pub = rospy.Publisher('~particles',   PoseArray, queue_size=10)
        self.estimate_pub  = rospy.Publisher('~pf_estimate', Pose,      queue_size=10)

        rospy.Subscriber('~odom',         Odometry,          self._odom_cb,      queue_size=10)
        rospy.Subscriber('~ar_detection', Float64MultiArray, self._detection_cb, queue_size=10)

        rospy.loginfo('Particle filter ready — %d particles, sigma_d=%.3f m, sigma_b=%.3f rad',
                      N_PARTICLES, SIGMA_DIST, SIGMA_BEAR)

    # ── Initialisation ────────────────────────────────────────────────────

    def _uniform_init(self):
        p = np.zeros((N_PARTICLES, 3))
        p[:, 0] = np.random.uniform(ROOM_X_MIN, ROOM_X_MAX, N_PARTICLES)
        p[:, 1] = np.random.uniform(ROOM_Y_MIN, ROOM_Y_MAX, N_PARTICLES)
        p[:, 2] = np.random.uniform(-math.pi, math.pi,      N_PARTICLES)
        return p

    # ── Motion model (predict) ────────────────────────────────────────────

    def _predict(self, curr, prev):
        dx   = curr[0] - prev[0]
        dy   = curr[1] - prev[1]
        dth  = _angle_diff(curr[2], prev[2])
        dtran = math.sqrt(dx * dx + dy * dy)

        drot1 = _angle_diff(math.atan2(dy, dx), prev[2]) if dtran > 1e-4 else 0.0
        drot2 = _angle_diff(dth, drot1)

        a1, a2, a3, a4 = ALPHA
        N = N_PARTICLES

        def _std(v):
            return math.sqrt(max(v, 1e-12))

        hr1 = drot1 + np.random.normal(0, _std(a1*drot1**2 + a2*dtran**2),       N)
        ht  = dtran  + np.random.normal(0, _std(a3*dtran**2 + a4*(drot1**2+drot2**2)), N)
        hr2 = drot2  + np.random.normal(0, _std(a1*drot2**2 + a2*dtran**2),       N)

        self.particles[:, 0] += ht * np.cos(self.particles[:, 2] + hr1)
        self.particles[:, 1] += ht * np.sin(self.particles[:, 2] + hr1)
        self.particles[:, 2] += hr1 + hr2
        self.particles[:, 2]  = (self.particles[:, 2] + math.pi) % (2*math.pi) - math.pi

        self.particles[:, 0] = np.clip(self.particles[:, 0], ROOM_X_MIN + 0.05, ROOM_X_MAX - 0.05)
        self.particles[:, 1] = np.clip(self.particles[:, 1], ROOM_Y_MIN + 0.05, ROOM_Y_MAX - 0.05)

    # ── Sensor model (update) ─────────────────────────────────────────────

    def _update(self, z_dist, z_bear):
        # Sanity check: reject measurements that are unrealistic for the grid
        # Grid is 0.9m x 0.9m, so max realistic distance is ~1.3m (diagonal)
        max_grid_dist = 1.5  # Allow some tolerance
        if z_dist > max_grid_dist:
            rospy.logwarn('Measurement rejected: distance %.2f m exceeds grid bounds (max ~%.2f m)', z_dist, max_grid_dist)
            return
        
        px  = self.particles[:, 0]
        py  = self.particles[:, 1]
        pth = self.particles[:, 2]

        likelihood = np.zeros(N_PARTICLES)

        for tx, ty in TAG_POSITIONS:
            dx = tx - px
            dy = ty - py
            exp_dist = np.sqrt(dx**2 + dy**2)
            exp_bear = (pth - np.arctan2(dy, dx) + math.pi) % (2*math.pi) - math.pi

            bd = (z_bear - exp_bear + math.pi) % (2*math.pi) - math.pi

            p_d = np.exp(-0.5 * ((z_dist - exp_dist) / SIGMA_DIST)**2)
            p_b = np.exp(-0.5 * (bd / SIGMA_BEAR)**2)
            likelihood += p_d * p_b

        self.weights *= (likelihood + MIN_WEIGHT)
        total = self.weights.sum()
        if total > 1e-15:
            self.weights /= total
        else:
            rospy.logwarn('Weight collapse — reinitialising particles')
            self.particles = self._uniform_init()
            self.weights   = np.ones(N_PARTICLES) / N_PARTICLES
            return

        n_eff = 1.0 / (np.sum(self.weights**2) + 1e-300)
        if n_eff < N_PARTICLES / 2:
            self._resample()

    # ── Low-variance resampling ───────────────────────────────────────────

    def _resample(self):
        cumsum = np.cumsum(self.weights)
        r      = np.random.uniform(0, 1.0 / N_PARTICLES)
        step   = 1.0 / N_PARTICLES
        idx, j = [], 0
        for m in range(N_PARTICLES):
            u = r + m * step
            while u > cumsum[j]:
                j += 1
                if j >= N_PARTICLES:
                    j = N_PARTICLES - 1
                    break
            idx.append(j)
        self.particles = self.particles[idx]
        self.weights   = np.ones(N_PARTICLES) / N_PARTICLES

    # ── Weighted mean estimate ────────────────────────────────────────────

    def _weighted_mean(self):
        w = self.weights
        # Use top-25% particles to avoid multi-modal mean oscillation
        threshold = np.percentile(w, 75)
        mask = w >= threshold
        w_top = w[mask]
        w_top = w_top / w_top.sum()
        pts = self.particles[mask]
        x = float(np.sum(w_top * pts[:, 0]))
        y = float(np.sum(w_top * pts[:, 1]))
        th = math.atan2(float(np.sum(w_top * np.sin(pts[:, 2]))),
                        float(np.sum(w_top * np.cos(pts[:, 2]))))
        return x, y, th

    # ── Publishers ────────────────────────────────────────────────────────

    def _publish(self):
        stamp = rospy.Time.now()

        pa = PoseArray()
        pa.header.stamp    = stamp
        pa.header.frame_id = 'map'
        for i in range(N_PARTICLES):
            p = Pose()
            p.position.x = float(self.particles[i, 0])
            p.position.y = float(self.particles[i, 1])
            p.position.z = float(self.weights[i] * N_PARTICLES)
            pa.poses.append(p)
        self.particles_pub.publish(pa)

        ex, ey, eth = self._weighted_mean()
        ep = Pose()
        ep.position.x = ex
        ep.position.y = ey
        ep.position.z = eth   # yaw encoded in z
        self.estimate_pub.publish(ep)

    # ── Callbacks ─────────────────────────────────────────────────────────

    def _odom_cb(self, msg):
        x   = msg.pose.pose.position.x
        y   = msg.pose.pose.position.y
        yaw = _quat_to_yaw(msg.pose.pose.orientation)
        curr = (x, y, yaw)

        with self.lock:
            if self.prev_odom is None:
                self.prev_odom = curr
                return
            self._predict(curr, self.prev_odom)
            self.prev_odom = curr
            self.odom_traj.append((x, y))
            if len(self.odom_traj) > 1000:
                self.odom_traj.pop(0)
            self._publish()

    def _detection_cb(self, msg):
        if len(msg.data) < 2:
            return
        z_dist = msg.data[0]
        z_bear = msg.data[1]
        rospy.loginfo('AR Detection received: distance=%.3f m, bearing=%.3f rad', z_dist, z_bear)
        with self.lock:
            self._update(z_dist, z_bear)
            ex, ey, _ = self._weighted_mean()
            self.pf_traj.append((ex, ey))
            if len(self.pf_traj) > 1000:
                self.pf_traj.pop(0)
            self._publish()


def main():
    node = ParticleFilterNode()
    rospy.spin()


if __name__ == '__main__':
    main()
